# ================= ACCOUNTING CALCULATOR =================
<AccountingCalculatorScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#1a1a2e')
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(5)
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#0f3460')
                Rectangle:
                    pos: self.pos
                    size: self.size
            Button:
                text: '<'
                font_size: sp(22)
                size_hint_x: None
                width: dp(50)
                background_normal: ''
                background_color: get_color_from_hex('#e94560')
                on_release: app.go_back()
            Label:
                text: 'Accounting Calculator'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex('#ffffff')
        Label:
            id: display
            text: '0.00'
            font_size: sp(30)
            color: get_color_from_hex('#ffffff')
            size_hint_y: None
            height: dp(70)
            halign: 'right'
            valign: 'middle'
            padding_x: dp(15)
            text_size: self.size
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#16213e')
                Rectangle:
                    pos: self.pos
                    size: self.size
        GridLayout:
            cols: 4
            spacing: dp(4)
            padding: dp(4)
            FunctionButton:
                text: 'C'
                on_release: root.clear()
            FunctionButton:
                text: 'Tax 5%'
                on_release: root.apply_tax(5)
            FunctionButton:
                text: 'Tax 10%'
                on_release: root.apply_tax(10)
            FunctionButton:
                text: 'Disc 5%'
                on_release: root.apply_discount(5)
            CalcButton:
                text: '7'
                on_release: root.add_digit('7')
            CalcButton:
                text: '8'
                on_release: root.add_digit('8')
            CalcButton:
                text: '9'
                on_release: root.add_digit('9')
            OperatorButton:
                text: '/'
                on_release: root.set_operator('/')
            CalcButton:
                text: '4'
                on_release: root.add_digit('4')
            CalcButton:
                text: '5'
                on_release: root.add_digit('5')
            CalcButton:
                text: '6'
                on_release: root.add_digit('6')
            OperatorButton:
                text: 'x'
                on_release: root.set_operator('*')
            CalcButton:
                text: '1'
                on_release: root.add_digit('1')
            CalcButton:
                text: '2'
                on_release: root.add_digit('2')
            CalcButton:
                text: '3'
                on_release: root.add_digit('3')
            OperatorButton:
                text: '-'
                on_release: root.set_operator('-')
            CalcButton:
                text: '0'
                size_hint_x: 2
                on_release: root.add_digit('0')
            CalcButton:
                text: '.'
