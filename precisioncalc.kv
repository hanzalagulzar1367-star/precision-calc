#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import get_color_from_hex kivy.utils.get_color_from_hex

<MenuButton@Button>:
    size_hint_y: None
    height: dp(55)
    background_normal: ''
    background_color: get_color_from_hex('#0f3460')
    color: get_color_from_hex('#ffffff')
    font_size: sp(15)

<CalcButton@Button>:
    background_normal: ''
    background_color: get_color_from_hex('#1f4287')
    color: get_color_from_hex('#ffffff')
    font_size: sp(20)
    size_hint: (1, 1)

<OperatorButton@CalcButton>:
    background_color: get_color_from_hex('#e94560')
    font_size: sp(22)

<FunctionButton@CalcButton>:
    background_color: get_color_from_hex('#16213e')
    font_size: sp(16)


# ================= ROOT =================
RootWidget:
    id: root_widget
    ScreenManager:
        id: sm

        # ✅ HOME IS FIRST — app starts here
        HomeScreen:
            name: 'home'
        SimpleCalculatorScreen:
            name: 'simple'
        ScientificCalculatorScreen:
            name: 'scientific'
        StatisticalCalculatorScreen:
            name: 'statistical'
        SimpleConversionsScreen:
            name: 'simple_conv'
        ScientificConversionsScreen:
            name: 'scientific_conv'
        CurrencyConverterScreen:
            name: 'currency'
        EngineeringCalculatorScreen:
            name: 'engineering'
        BinaryConverterScreen:
            name: 'binary'
        AccountingCalculatorScreen:
            name: 'accounting'


<RootWidget@BoxLayout>:
    orientation: 'vertical'


# ================= HOME SCREEN =================
<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#1a1a2e')
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(15), 0
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#0f3460')
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: 'PrecisionCalc'
                font_size: sp(22)
                bold: True
                color: get_color_from_hex('#e94560')
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(10)
                spacing: dp(8)

                MenuButton:
                    text: 'Simple Calculator'
                    on_release: app.go_to('simple')
                MenuButton:
                    text: 'Scientific Calculator'
                    on_release: app.go_to('scientific')
                MenuButton:
                    text: 'Statistical Calculator'
                    on_release: app.go_to('statistical')
                MenuButton:
                    text: 'Simple Conversions'
                    on_release: app.go_to('simple_conv')
                MenuButton:
                    text: 'Scientific Conversions'
                    on_release: app.go_to('scientific_conv')
                MenuButton:
                    text: 'Currency Converter'
                    on_release: app.go_to('currency')
                MenuButton:
                    text: 'Engineering Calculator'
                    on_release: app.go_to('engineering')
                MenuButton:
                    text: 'Binary Converter'
                    on_release: app.go_to('binary')
                MenuButton:
                    text: 'Accounting Calculator'
                    on_release: app.go_to('accounting')


# ================= SIMPLE CALCULATOR =================
<SimpleCalculatorScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#1a1a2e')
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(5)
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#0f3460')
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: '<'
                font_size: sp(22)
                size_hint_x: None
                width: dp(50)
                background_normal: ''
                background_color: get_color_from_hex('#e94560')
                on_release: app.go_back()

            Label:
                text: 'Simple Calculator'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex('#ffffff')

        Label:
            id: display
            text: '0'
            font_size: sp(36)
            color: get_color_from_hex('#ffffff')
            size_hint_y: None
            height: dp(80)
            halign: 'right'
            valign: 'middle'
            padding_x: dp(15)
            text_size: self.size
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#16213e')
                Rectangle:
                    pos: self.pos
                    size: self.size

        GridLayout:
            cols: 4
            spacing: dp(4)
            padding: dp(4)

            FunctionButton:
                text: 'C'
                on_release: root.clear()
            FunctionButton:
                text: '+/-'
                on_release: root.toggle_sign()
            FunctionButton:
                text: '%'
                on_release: root.percent()
            OperatorButton:
                text: '/'
                on_release: root.set_operator('/')

            CalcButton:
                text: '7'
                on_release: root.add_digit('7')
            CalcButton:
                text: '8'
                on_release: root.add_digit('8')
            CalcButton:
                text: '9'
                on_release: root.add_digit('9')
            OperatorButton:
                text: 'x'
                on_release: root.set_operator('*')

            CalcButton:
                text: '4'
                on_release: root.add_digit('4')
            CalcButton:
                text: '5'
                on_release: root.add_digit('5')
            CalcButton:
                text: '6'
                on_release: root.add_digit('6')
            OperatorButton:
                text: '-'
                on_release: root.set_operator('-')

            CalcButton:
                text: '1'
                on_release: root.add_digit('1')
            CalcButton:
                text: '2'
                on_release: root.add_digit('2')
            CalcButton:
                text: '3'
                on_release: root.add_digit('3')
            OperatorButton:
                text: '+'
                on_release: root.set_operator('+')

            CalcButton:
                text: '0'
                size_hint_x: 2
                on_release: root.add_digit('0')
            CalcButton:
                text: '.'
                on_release: root.add_digit('.')
            OperatorButton:
                text: '='
                on_release: root.calculate()


# ================= SCIENTIFIC CALCULATOR =================
<ScientificCalculatorScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#1a1a2e')
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(5)
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#0f3460')
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: '<'
                font_size: sp(22)
                size_hint_x: None
                width: dp(50)
                background_normal: ''
                background_color: get_color_from_hex('#e94560')
                on_release: app.go_back()

            Label:
                text: 'Scientific Calculator'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex('#ffffff')

        Label:
            id: display
            text: '0'
            font_size: sp(30)
            color: get_color_from_hex('#ffffff')
            size_hint_y: None
            height: dp(70)
            halign: 'right'
            valign: 'middle'
            padding_x: dp(15)
            text_size: self.size
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#16213e')
                Rectangle:
                    pos: self.pos
                    size: self.size

        GridLayout:
            cols: 5
            size_hint_y: None
            height: dp(45)
            spacing: dp(3)
            padding: dp(3)

            FunctionButton:
                text: 'sin'
                on_release: root.apply_function('sin')
            FunctionButton:
                text: 'cos'
                on_release: root.apply_function('cos')
            FunctionButton:
                text: 'tan'
                on_release: root.apply_function('tan')
            FunctionButton:
                text: 'log'
                on_release: root.apply_function('log')
            FunctionButton:
                text: 'ln'
                on_release: root.apply_function('ln')

            FunctionButton:
                text: 'x2'
                on_release: root.apply_function('square')
            FunctionButton:
                text: 'sqrt'
                on_release: root.apply_function('sqrt')
            FunctionButton:
                text: 'x!'
                on_release: root.apply_function('fact')
            FunctionButton:
                text: '1/x'
                on_release: root.apply_function('inv')
            FunctionButton:
                text: 'pi'
                on_release: root.apply_function('pi')

        GridLayout:
            cols: 4
            spacing: dp(3)
            padding: dp(3)

            FunctionButton:
                text: 'C'
                on_release: root.clear()
            FunctionButton:
                text: '+/-'
                on_release: root.toggle_sign()
            FunctionButton:
                text: 'e'
                on_release: root.apply_function('e')
            OperatorButton:
                text: '/'
                on_release: root.set_operator('/')

            CalcButton:
                text: '7'
                on_release: root.add_digit('7')
            CalcButton:
                text: '8'
                on_release: root.add_digit('8')
            CalcButton:
                text: '9'
                on_release: root.add_digit('9')
            OperatorButton:
                text: 'x'
                on_release: root.set_operator('*')

            CalcButton:
                text: '4'
                on_release: root.add_digit('4')
            CalcButton:
                text: '5'
                on_release: root.add_digit('5')
            CalcButton:
                text: '6'
                on_release: root.add_digit('6')
            OperatorButton:
                text: '-'
                on_release: root.set_operator('-')

            CalcButton:
                text: '1'
                on_release: root.add_digit('1')
            CalcButton:
                text: '2'
                on_release: root.add_digit('2')
            CalcButton:
                text: '3'
                on_release: root.add_digit('3')
            OperatorButton:
                text: '+'
                on_release: root.set_operator('+')

            CalcButton:
                text: '0'
                size_hint_x: 2
                on_release: root.add_digit('0')
            CalcButton:
                text: '.'
                on_release: root.add_digit('.')
            OperatorButton:
                text: '='
                on_release: root.calculate()
            OperatorButton:
                text: '^'
                on_release: root.set_operator('^')


# ================= STATISTICAL CALCULATOR =================
<StatisticalCalculatorScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#1a1a2e')
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(5)
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#0f3460')
                Rectangle:
                    pos: self.pos
                    size: self.size
            Button:
                text: '<'
                font_size: sp(22)
                size_hint_x: None
                width: dp(50)
                background_normal: ''
                background_color: get_color_from_hex('#e94560')
                on_release: app.go_back()
            Label:
                text: 'Statistical Calculator'
                font_size: sp(18)
                bold: True
                color: get_color_from_hex('#ffffff')

        Label:
            id: display
            text: 'Enter numbers, tap Add'
            font_size: sp(14)
            color: get_color_from_hex('#ffffff')
            size_hint_y: None
            height: dp(60)
            halign: 'right'
            valign: 'middle'
            padding_x: dp(10)
            text_size: self.size
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#16213e')
                Rectangle:
                    pos: self.pos
                    size: self.size

        Label:
            id: result
            text: ''
            font_size: sp(16)
            color: get_color_from_hex('#e94560')
            size_hint_y: None
            height: dp(40)

        GridLayout:
            cols: 3
            spacing: dp(4)
            padding: dp(4)

            CalcButton:
                text: '7'
                on_release: root.add_digit('7')
            CalcButton:
                text: '8'
                on_release: root.add_digit('8')
            CalcButton:
                text: '9'
                on_release: root.add_digit('9')
            CalcButton:
                text: '4'
                on_release: root.add_digit('4')
            CalcButton:
                text: '5'
                on_release: root.add_digit('5')
            CalcButton:
                text: '6'
                on_release: root.add_digit('6')
            CalcButton:
                text: '1'
                on_release: root.add_digit('1')
            CalcButton:
                text: '2'
                on_release: root.add_digit('2')
            CalcButton:
                text: '3'
                on_release: root.add_digit('3')
            CalcButton:
                text: '0'
                on_release: root.add_digit('0')
            CalcButton:
                text: '.'
                on_release: root.add_digit('.')
            CalcButton:
                text: ','
                on_release: root.add_digit(',')

            OperatorButton:
                text: 'Add'
                on_release: root.add_number()
            FunctionButton:
                text: 'Clear'
                on_release: root.clear()
            FunctionButton:
                text: 'Mean'
                on_release: root.calculate_stat('mean')
            FunctionButton:
                text: 'Median'
                on_release: root.calculate_stat('median')
            FunctionButton:
                text: 'Mode'
                on_release: root.calculate_stat('mode')
            FunctionButton:
                text: 'Sum'
                on_release: root.calculate_stat('sum')
            FunctionButton:
                text: 'Stdev'
                on_release: root.calculate_stat('stdev')
            FunctionButton:
                text: 'Min'
                on_release: root.calculate_stat('min')
            FunctionButton:
                text: 'Max'
                on_release: root.calculate_stat('max')
            FunctionButton:
                text: 'Count'
                on_release: root.calculate_stat('count')


